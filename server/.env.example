NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=2
PARSE_TIMEOUT_MS=12000
PARSE_PROBE_TIMEOUT_MS=5000
PARSE_PROBE_MAX_CANDIDATES=3
PARSE_MAX_CONCURRENT_PER_CLIENT=2
PARSE_MAX_CONCURRENT_TOTAL=16
PARSE_MAX_RESPONSE_BYTES=2097152
PARSE_CACHE_TTL_MS=600000
PARSE_RATE_LIMIT_PER_MINUTE=30

# Public, anonymous Bilibili videos only. No account cookies, paid content, membership bypass, or DRM handling.
BILIBILI_ENABLED=true
BILIBILI_TIMEOUT_MS=12000
BILIBILI_RATE_LIMIT_PER_MINUTE=20
BILIBILI_DANMAKU_MAX_ITEMS=3000
BILIBILI_DANMAKU_MAX_RESPONSE_BYTES=8388608
BILIBILI_CACHE_TTL_MS=600000

HLS_PROXY_ENABLED=true
HLS_PROXY_TIMEOUT_MS=30000
HLS_PROXY_RATE_LIMIT_PER_MINUTE=120
HLS_PROXY_MAX_CONCURRENT_PER_CLIENT=8
HLS_PROXY_MAX_CONCURRENT_TOTAL=64
HLS_PROXY_ALLOWED_HOSTS=
MEDIA_PROXY_TOKEN_TTL_MS=21600000
MEDIA_PROXY_TOKEN_MAX_ACTIVE=50000
PROXY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

ROOM_STORE_ENABLED=true
ROOM_STORE_FILE=data/rooms.json
ROOM_STORE_WRITE_DELAY_MS=800
ROOM_STORE_SHUTDOWN_TIMEOUT_MS=20000
ROOM_STORE_MAX_BYTES=67108864
ROOM_STORE_MAX_ROOM_BYTES=3145728
# Historical snapshots may contain more rooms than the current creation limit.
ROOM_STORE_MAX_ROOMS=500
ROOM_MAX_MEMBERS=20
ROOM_MAX_RECONNECT_ENTRIES=100
ROOM_MAX_ACTIVE=20
ROOM_CREATE_RATE_LIMIT_PER_MINUTE=10
ROOM_MAX_PLAYLIST_ITEMS=200
ROOM_MAX_KICKED_ENTRIES=400
ROOM_EMPTY_TTL_MS=7200000
ROOM_RECONNECT_GRACE_MS=120000
ROOM_HOST_RECONNECT_GRACE_MS=60000
